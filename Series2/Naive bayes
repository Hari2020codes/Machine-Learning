from sklearn.datasets import load_iris
from sklearn.model_selection import train_test_split
from sklearn.naive_bayes import GaussianNB

# Load Iris dataset features and targets
X, y = load_iris(return_X_y=True)

# Split dataset with 50% test size
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.5, random_state=0)

# Initialize and train Gaussian Naive Bayes model
gnb = GaussianNB()
y_pred = gnb.fit(X_train, y_train).predict(X_test)
print(y_pred)

# Predict for a new input sample
x_new = [[5, 5, 4, 4]]
y_new = gnb.fit(X_train, y_train).predict(x_new)
print("predicted output for [[5,5,4,4]]:", y_new)

# Print model score
print("Naive Bayes score:", gnb.score(X_test, y_test))
